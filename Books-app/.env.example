# 로컬 개발용 환경변수 예시
#
# 사용법
#   cp .env.example .env
#   .env 를 채운다
#
# .env 는 커밋하지 않는다 (.gitignore / .dockerignore 양쪽에 있다)
# 이 파일(.env.example)은 커밋한다 — 무엇이 필요한지 알려주되 값은 비운다

# ── Compose 가 쓰는 값 ────────────────────────────────
POSTGRES_PASSWORD=
APP_DB_PASSWORD=

# ── 앱이 쓰는 값 ──────────────────────────────────────
# 필수. 없으면 기동에 실패한다 (config.py 의 required)
#   sslmode / rediss 로 TLS 여부까지 여기서 결정된다 (02 문서)
#   로컬   sslmode=disable / redis://
#   RDS    sslmode=require / rediss://
#
# Compose 를 쓰면 compose.yaml 이 이 값을 조립해 넣는다.
# 앱을 직접 실행할 때만 아래를 채운다.
# DATABASE_URL=postgresql://books_app:localdev@localhost:5432/books?sslmode=disable
# REDIS_URL=redis://localhost:6379/0

# ── 선택. 기본값이 있다 ───────────────────────────────
# LOG_LEVEL=debug
# CACHE_TTL_SECONDS=60
# DB_POOL_MIN=2
# DB_POOL_MAX=10
# QUEUE_NAME=order_queue
# WORKER_PROCESS_SECONDS=1.0
# WORKER_FAILURE_RATE=0.0
# SHUTDOWN_GRACE_SECONDS=5

# ── 장애 주입. 기본 꺼짐 ──────────────────────────────
# 실수로 켠 채 배포되면 그 자체가 사고다 (06 문서)
# ENABLE_DEBUG_ENDPOINTS=false
